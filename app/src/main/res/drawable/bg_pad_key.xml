<?xml version="1.0" encoding="utf-8"?>
<!-- D-pad key, round. Never a solid accent flood on press: the pressed fill is
     surface_pressed plus an accent stroke so the glyph keeps @color/text contrast. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/unavailable"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="@dimen/border_focus" android:color="@color/accent" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface_high" />
            <stroke android:width="@dimen/border_focus" android:color="@color/accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/border_hairline" android:color="@color/divider" />
        </shape>
    </item>

</selector>
