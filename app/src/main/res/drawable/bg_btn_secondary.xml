<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action button. Pressed = surface_pressed + accent stroke, label
     stays @color/text (11.61:1). The old solid accent press was 2.25:1. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_key" />
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/border_hairline" android:color="@color/divider" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_key" />
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="@dimen/border_press" android:color="@color/accent" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_key" />
            <solid android:color="@color/surface_high" />
            <stroke android:width="@dimen/border_focus" android:color="@color/accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_key" />
            <solid android:color="@color/surface" />
            <stroke android:width="@dimen/border_hairline" android:color="@color/stroke" />
        </shape>
    </item>

</selector>
