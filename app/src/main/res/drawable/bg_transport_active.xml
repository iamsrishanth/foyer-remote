<?xml version="1.0" encoding="utf-8"?>
<!-- Transport segment, SELECTED variant. Same pill as bg_transport_item.xml but
     surface_pressed fill + 1.5dp accent stroke, so the selection is carried by a
     fill change AND a stroke, and the label stays @color/text (11.4:1 here).
     MainActivity references this name directly. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/unavailable"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface_high" />
            <stroke android:width="@dimen/border_press" android:color="@color/accent" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="@dimen/border_focus" android:color="@color/accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="@color/surface_pressed" />
            <stroke android:width="@dimen/border_press" android:color="@color/accent" />
        </shape>
    </item>

</selector>
