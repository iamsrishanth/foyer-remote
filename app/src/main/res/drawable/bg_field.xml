<?xml version="1.0" encoding="utf-8"?>
<!-- Text fields: 10dp radius, recessed fill, hairline; focus is an accent ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_input" />
            <solid android:color="@color/bg" />
            <stroke android:width="@dimen/border_focus" android:color="@color/accent" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_input" />
            <solid android:color="@color/bg" />
            <stroke android:width="@dimen/border_hairline" android:color="@color/stroke" />
        </shape>
    </item>

</selector>
